MONGO_URI=
JWT_SECRET=change_me_to_a_long_random_string

# Access token lifetime (default 8h). Rotating JWT_SECRET forces all staff to re-login.
JWT_EXPIRES_IN=8h

# Exact SPA origin — CORS allows only this origin (no wildcard).
# Production example: https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

PORT=5000
NODE_ENV=development

# Log verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Log files are written to Backend/logs/:
#   app.log    — all log entries
#   http.log   — every API request (status, duration, failures + reason)
#   auth.log   — login/register/auth middleware events
#   errors.log — errors only (500s, unhandled exceptions)
#
# Never put JWT_SECRET or MONGO_URI into application log statements.
