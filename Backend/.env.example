MONGO_URI=
JWT_SECRET=change_me_to_a_long_random_string

# Log verbosity: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Log files are written to Backend/logs/:
#   app.log    — all log entries
#   http.log   — every API request (status, duration, failures + reason)
#   auth.log   — login/register/auth middleware events
#   errors.log — errors only (500s, unhandled exceptions)
