# Backend API base URL — must include /api (routes are mounted at /api/*)
VITE_API_URL=http://localhost:5000/api

# Optional display name (safe to expose — bundled into the client)
VITE_APP_NAME=FlamFactory

# Production example:
# VITE_API_URL=https://flame-factory.onrender.com/api
#
# Never prefix secrets with VITE_ — Vite embeds every VITE_* var in the browser bundle.
